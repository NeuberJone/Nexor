<UserControl x:Class="Nexor.Desktop.Presentation.Views.OperationView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
 <Grid Background="{DynamicResource AppBg}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="220"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="Impressora" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding Machines}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectedValue="{Binding Machine,Mode=TwoWay}" Margin="8,0,18,0"/><TextBlock Grid.Column="2" Text="Nome do rolo" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding RollName,UpdateSourceTrigger=PropertyChanged}" Margin="8,0" Padding="6"/></Grid><WrapPanel HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Importar arquivos" Command="{Binding ImportFilesCommand}" Padding="12,7" Margin="4,0"/><Button Content="Importar pasta" Command="{Binding ImportFolderCommand}" Padding="12,7" Margin="4,0"/><Button Content="PDF completo + JPG" Command="{Binding ExportFullCommand}" Padding="12,7" Margin="4,0"/><Button Content="PDF resumido + JPG" Command="{Binding ExportSummaryCommand}" Padding="12,7" Margin="4,0"/><Button Content="Limpar" Command="{Binding ClearCommand}" Padding="12,7" Margin="4,0"/><Button Content="Fechar rolo" Command="{Binding SaveRollCommand}" Padding="12,7" Margin="4,0"/></WrapPanel></StackPanel></Border>
  <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"><DataGrid.Columns><DataGridTextColumn Header="EndTime" Binding="{Binding EndTime,StringFormat=dd/MM/yyyy HH:mm:ss}" Width="150"/><DataGridTextColumn Header="Arquivo/Pedido" Binding="{Binding Document}" Width="*"/><DataGridTextColumn Header="Tecido" Binding="{Binding Fabric}" Width="150"/><DataGridTextColumn Header="HeightMM" Binding="{Binding HeightMm}" Width="90"/><DataGridTextColumn Header="VPositionMM" Binding="{Binding VPositionMm}" Width="100"/><DataGridTextColumn Header="Real (m)" Binding="{Binding RealLengthMeters,StringFormat=F3}" Width="90"/></DataGrid.Columns></DataGrid>
  <DataGrid Grid.Row="2" ItemsSource="{Binding Blocks}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,12,0,0"><DataGrid.Columns><DataGridTextColumn Header="Tecido / bloco consecutivo" Binding="{Binding Fabric}" Width="*"/><DataGridTextColumn Header="Itens" Binding="{Binding ItemCount}" Width="80"/><DataGridTextColumn Header="Total (m)" Binding="{Binding TotalMeters,StringFormat=F2}" Width="100"/><DataGridTextColumn Header="Último fim" Binding="{Binding NewestEnd,StringFormat=dd/MM/yyyy HH:mm:ss}" Width="160"/></DataGrid.Columns></DataGrid>
  <TextBlock Grid.Row="3" Text="{Binding Status}" Foreground="{DynamicResource Muted}" Margin="2,10,0,0"/>
 </Grid>
</UserControl>
