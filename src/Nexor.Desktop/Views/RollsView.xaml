<UserControl x:Class="Nexor.Desktop.Presentation.Views.RollsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{DynamicResource AppBg}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="1.2*"/></Grid.RowDefinitions>
  <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel Orientation="Horizontal"><TextBlock Text="Impressora" VerticalAlignment="Center"/><ComboBox Width="220" ItemsSource="{Binding Machines}" DisplayMemberPath="DisplayName" SelectedValuePath="Code" SelectedValue="{Binding Machine,Mode=TwoWay}" Margin="8,0,18,0"/><TextBlock Text="Rolo, pedido ou arquivo" VerticalAlignment="Center"/><TextBox Width="280" Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Margin="8,0" Padding="6"/><Button Content="Buscar" Command="{Binding SearchCommand}" Padding="16,7"/></StackPanel></Border>
  <DataGrid Grid.Row="1" ItemsSource="{Binding Rolls}" SelectedItem="{Binding SelectedRoll}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/><DataGridTextColumn Header="Rolo" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Máquina" Binding="{Binding Machine}" Width="80"/><DataGridTextColumn Header="Criado" Binding="{Binding CreatedAt,StringFormat=dd/MM/yyyy HH:mm:ss}" Width="160"/><DataGridTextColumn Header="Total (m)" Binding="{Binding TotalMeters,StringFormat=F2}" Width="100"/><DataGridTextColumn Header="Itens" Binding="{Binding ItemCount}" Width="70"/></DataGrid.Columns></DataGrid>
  <TabControl Grid.Row="2" Margin="0,12,0,0"><TabItem Header="Resumo"><StackPanel Margin="12"><TextBlock Text="{Binding SelectedRoll.Name,StringFormat=Rolo: {0}}" FontSize="18" FontWeight="Bold"/><TextBlock Text="{Binding SelectedRoll.Machine,StringFormat=Máquina: {0}}"/><TextBlock Text="{Binding SelectedRoll.TotalMeters,StringFormat=Total: {0:F2} m}"/><TextBlock Text="{Binding SelectedRoll.ItemCount,StringFormat=Itens: {0}}"/></StackPanel></TabItem><TabItem Header="Itens"><DataGrid ItemsSource="{Binding SelectedRoll.Items}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="EndTime" Binding="{Binding EndTime,StringFormat=dd/MM/yyyy HH:mm:ss}" Width="150"/><DataGridTextColumn Header="Documento" Binding="{Binding Document}" Width="*"/><DataGridTextColumn Header="Tecido" Binding="{Binding Fabric}" Width="150"/><DataGridTextColumn Header="Real (m)" Binding="{Binding EffectiveMeters,StringFormat=F3}" Width="90"/></DataGrid.Columns></DataGrid></TabItem><TabItem Header="Eventos"><DataGrid ItemsSource="{Binding SelectedRoll.Events}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Data/Hora" Binding="{Binding CreatedAt,StringFormat=dd/MM/yyyy HH:mm:ss}" Width="160"/><DataGridTextColumn Header="Tipo" Binding="{Binding EventType}" Width="150"/><DataGridTextColumn Header="Resumo" Binding="{Binding Message}" Width="*"/></DataGrid.Columns></DataGrid></TabItem></TabControl>
 </Grid>
</UserControl>
