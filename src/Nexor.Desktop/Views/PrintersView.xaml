<UserControl x:Class="Nexor.Desktop.Presentation.Views.PrintersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Background="{DynamicResource AppBg}"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
  <Border Style="{StaticResource Card}" Margin="0,0,12,0"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Impressoras cadastradas" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="As impressoras ativas aparecem na tela de operação." Foreground="{DynamicResource Muted}" Margin="0,4,0,12"/></StackPanel><DataGrid ItemsSource="{Binding Printers}" SelectedItem="{Binding Selected}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Identificação" Binding="{Binding Code}" Width="100"/><DataGridTextColumn Header="Nome" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="Marca / modelo" Binding="{Binding Description}" Width="*"/><DataGridCheckBoxColumn Header="Ativa" Binding="{Binding IsActive}" Width="60"/></DataGrid.Columns></DataGrid></DockPanel></Border>
  <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Dados da impressora" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="Identificação da máquina *"/><TextBox Text="{Binding Code,UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="0,4,0,10" ToolTip="Código usado nos logs e rolos, por exemplo M1 ou SUBLIMATICA"/><TextBlock Text="Nome de exibição *"/><TextBox Text="{Binding DisplayName,UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="0,4,0,10"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Marca / fabricante"/><TextBox Text="{Binding Manufacturer,UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="0,4,0,10"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Modelo"/><TextBox Text="{Binding Model,UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="0,4,0,10"/></StackPanel></Grid><TextBlock Text="Observações"/><TextBox Text="{Binding Notes,UpdateSourceTrigger=PropertyChanged}" Padding="7" Margin="0,4,0,10" Height="80" AcceptsReturn="True" TextWrapping="Wrap"/><CheckBox Content="Impressora ativa" IsChecked="{Binding IsActive}" Margin="0,4,0,14"/><WrapPanel HorizontalAlignment="Right"><Button Content="Nova" Command="{Binding NewCommand}" Padding="16,8" Margin="4"/><Button Content="Excluir" Command="{Binding DeleteCommand}" Padding="16,8" Margin="4"/><Button Content="Salvar" Command="{Binding SaveCommand}" Padding="20,8" Margin="4"/></WrapPanel><TextBlock Text="{Binding Status}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
 </Grid>
</UserControl>
