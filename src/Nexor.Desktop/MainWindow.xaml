<Window x:Class="Nexor.Desktop.Presentation.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="clr-namespace:Nexor.Desktop.Presentation.ViewModels" xmlns:views="clr-namespace:Nexor.Desktop.Presentation.Views" Title="{Binding WindowTitle}" Width="1280" Height="800" MinWidth="980" MinHeight="620" WindowStartupLocation="CenterScreen">
 <Window.Resources><DataTemplate DataType="{x:Type vm:OperationViewModel}"><views:OperationView/></DataTemplate><DataTemplate DataType="{x:Type vm:RollsViewModel}"><views:RollsView/></DataTemplate><DataTemplate DataType="{x:Type vm:PrintersViewModel}"><views:PrintersView/></DataTemplate></Window.Resources>
 <Grid Background="{DynamicResource AppBg}"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource SidebarBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"><DockPanel>
   <StackPanel DockPanel.Dock="Top" Margin="18,22,18,24"><TextBlock Text="NEXOR" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource Accent}"/><TextBlock Text="{Binding EditionLabel}" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel>
   <StackPanel DockPanel.Dock="Top"><Button Style="{StaticResource NavButton}" Content="Home" Command="{Binding NavigateCommand}" CommandParameter="Home"/><Button Style="{StaticResource NavButton}" Content="Operação" Command="{Binding NavigateCommand}" CommandParameter="Operação"/><Button Style="{StaticResource NavButton}" Content="Rolos" Command="{Binding NavigateCommand}" CommandParameter="Rolos"/><Button Style="{StaticResource NavButton}" Content="Configurações" Command="{Binding NavigateCommand}" CommandParameter="Configurações"/><Button Style="{StaticResource NavButton}" Content="Sobre" Command="{Binding NavigateCommand}" CommandParameter="Sobre"/></StackPanel>
   <TextBlock DockPanel.Dock="Bottom" Text="v0.2.6 · banco local" Foreground="{DynamicResource Muted}" Margin="18"/>
  </DockPanel></Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="30"/></Grid.RowDefinitions>
   <Border Background="{DynamicResource TopbarBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid Margin="24,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding CurrentPage}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding PageDescription}" Foreground="{DynamicResource Muted}"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Tema" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox Width="145" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></Grid></Border>
   <Grid Grid.Row="1" Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <UniformGrid Columns="3" Margin="0,0,0,18"><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Importação" Foreground="{DynamicResource Muted}"/><TextBlock Text="Preparada" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,0,12,0"><StackPanel><TextBlock Text="Máquinas" Foreground="{DynamicResource Muted}"/><TextBlock Text="M1 · M2" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Persistência" Foreground="{DynamicResource Muted}"/><TextBlock Text="SQLite local" FontSize="22" FontWeight="Bold" Margin="0,8,0,0"/></StackPanel></Border></UniformGrid>
    <Border Grid.Row="1" Style="{StaticResource Card}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="{Binding CurrentPage}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center"/><TextBlock Text="A base desta área está pronta para a implementação funcional incremental." Foreground="{DynamicResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"/></StackPanel></Border>
   </Grid>
   <ContentControl Grid.Row="1" Content="{Binding CurrentPageContent}" Margin="24"><ContentControl.Style><Style TargetType="ContentControl"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><Trigger Property="Content" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></ContentControl.Style></ContentControl>
   <Border Grid.Row="2" Background="{DynamicResource TopbarBg}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><TextBlock Text="Pronto · dados permanecem neste computador" Foreground="{DynamicResource Muted}" Margin="14,6" FontSize="11"/></Border>
  </Grid>
 </Grid>
</Window>
